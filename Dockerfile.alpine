# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# check=error=true

ARG BASE_IMAGE=alpine:3.24

FROM ${BASE_IMAGE} AS build
SHELL ["/bin/ash", "-euo", "pipefail", "-c"]
RUN apk add --no-cache \
      binutils \
      ca-certificates \
      curl \
      git

# Go comes from go.dev instead of the distro, so that both distros build with
# the same release and get Go's security fixes when Go publishes them. Update
# the version and both checksums together, from https://go.dev/dl/.
# GOTOOLCHAIN=local keeps go from downloading another toolchain: AzCopy
# often raises the go line of its go.mod in a release, sometimes to a Go
# release that is only days old, and a release that needs a newer Go fails to
# build until the pin is raised.
ARG GO_TOOLCHAIN=go1.27.3
ARG GO_TOOLCHAIN_AMD64_SHA256=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
ARG GO_TOOLCHAIN_ARM64_SHA256=a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49
ARG TARGETARCH
RUN case "${TARGETARCH}" in \
      amd64) sha256="${GO_TOOLCHAIN_AMD64_SHA256}" ;; \
      arm64) sha256="${GO_TOOLCHAIN_ARM64_SHA256}" ;; \
      *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --proto '=https' --proto-redir '=https' --retry 3 -o /tmp/go.tar.gz \
      "https://dl.google.com/go/${GO_TOOLCHAIN}.linux-${TARGETARCH}.tar.gz"; \
    echo "${sha256}  /tmp/go.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/go.tar.gz -C /usr/local; \
    rm /tmp/go.tar.gz; \
    test "$(/usr/local/go/bin/go env GOVERSION)" = "${GO_TOOLCHAIN}"
# Modules come only from the Go module proxy and are checked against
# AzCopy's go.sum. Without cgo the binary is static.
ENV PATH=/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    GOTOOLCHAIN=local \
    GOPROXY=https://proxy.golang.org \
    GOSUMDB=sum.golang.org \
    CGO_ENABLED=0

# AzCopy publishes prebuilt binaries but no source tarball, so the release tag
# is cloned and must point to the commit pinned in package.yml.
ARG VERSION
ARG SOURCE_COMMIT
RUN printf '%s\n' "${VERSION}" | grep -Eqx '[0-9]+\.[0-9]+\.[0-9]+' \
      || { echo "unexpected VERSION: ${VERSION}" >&2; exit 1; }; \
    printf '%s\n' "${SOURCE_COMMIT}" | grep -Eqx '[0-9a-f]{40}' \
      || { echo "SOURCE_COMMIT must be a full commit id" >&2; exit 1; }; \
    git -c advice.detachedHead=false clone --quiet --depth 1 --branch "v${VERSION}" \
      https://github.com/Azure/azure-storage-azcopy.git /src/azcopy; \
    test "$(git -C /src/azcopy rev-parse HEAD)" = "${SOURCE_COMMIT}" \
      || { echo "tag v${VERSION} is not commit ${SOURCE_COMMIT}" >&2; exit 1; }; \
    grep -Fqx "const AzcopyVersion = \"${VERSION}\"" /src/azcopy/common/version.go \
      || { echo "common/version.go does not say ${VERSION}" >&2; exit 1; }
WORKDIR /src/azcopy
ARG JOBS
# netgo is the tag of upstream's Linux release build. Upstream also builds
# with cgo, which only the GNOME keyring login of its se_integration variant
# needs; this build leaves that variant out. Modules are checked against
# go.sum, which -mod=readonly keeps as it is, and the checkout stays in place
# so that the binary records the commit (go version -m shows it).
RUN mkdir -p /out/usr/local/bin; \
    go build -mod=readonly -trimpath -buildvcs=true -tags netgo -p "${JOBS:-$(nproc)}" \
      -ldflags "-s -w" -o /out/usr/local/bin/azcopy .; \
    go mod verify; \
    bin=/out/usr/local/bin/azcopy; \
    "$bin" --version > /tmp/azcopy-version; \
    printf '%s\n' "azcopy version ${VERSION}" > /tmp/azcopy-version.want; \
    cmp /tmp/azcopy-version.want /tmp/azcopy-version || { cat /tmp/azcopy-version >&2; exit 1; }; \
    go version -m "$bin" > /tmp/azcopy-modules; \
    awk -F '\t' '$2 == "build" { print $3 }' /tmp/azcopy-modules > /tmp/azcopy-build; \
    for setting in "vcs.revision=${SOURCE_COMMIT}" vcs.modified=false CGO_ENABLED=0 -trimpath=true -tags=netgo; do \
      grep -Fqx -- "$setting" /tmp/azcopy-build \
        || { cat /tmp/azcopy-modules >&2; echo "missing build setting: $setting" >&2; exit 1; }; \
    done; \
    readelf -lW "$bin" > /tmp/azcopy-elf; \
    if grep -Eq '^ +(INTERP|DYNAMIC) ' /tmp/azcopy-elf; then \
      cat /tmp/azcopy-elf >&2; echo "azcopy is not statically linked" >&2; exit 1; \
    fi

ARG BASE_IMAGE
ARG PUBLIC_SUFFIX_LIST_VERSION
ARG PUBLIC_SUFFIX_LIST_SHA256
ADD --checksum=sha256:${PUBLIC_SUFFIX_LIST_SHA256} https://raw.githubusercontent.com/publicsuffix/list/${PUBLIC_SUFFIX_LIST_VERSION}/public_suffix_list.dat /tmp/public_suffix_list.dat
# go-licenses.sh copies the license files at the root of each Go module linked
# into azcopy, and those of the Go distribution. The loops before it add the
# files kept below a module's root, in the directory of a linked package or in
# a directory between it and the root, such as the ISC license of the copy of
# go-spew in testify's internal/spew (ste imports testify's assert package).
# Go files whose names start like a license file are left out. AzCopy's own
# NOTICE.txt lists the third-party notices of Microsoft's release.
# golang.org/x/net/publicsuffix, which minio-go uses, embeds tables generated
# from Mozilla's Public Suffix List (MPL-2.0): licenses/ adds the list's notice
# and the MPL text, and the list itself, downloaded above, goes into
# mpl-sources/. The build stops when azcopy no longer links that package, or
# when its table.go names another commit of the list than the one pinned in
# package.yml. The binary loads no libraries, so runtime-deps only has the
# packages in runtime-deps.alpine.
RUN --mount=type=bind,source=scripts/go-licenses.sh,target=/tmp/go-licenses.sh \
    --mount=type=bind,source=licenses,target=/tmp/licenses \
    --mount=type=bind,source=runtime-deps.alpine,target=/tmp/runtime-deps.extra \
    meta=/out/usr/local/share/randomcontainers/azcopy; \
    mkdir -p "$meta/licenses"; \
    cp LICENSE NOTICE.txt "$meta/licenses/"; \
    cp -R /tmp/licenses/. "$meta/licenses/"; \
    go list -tags netgo -deps -f '{{if .Module}}{{with .Module.Replace}}{{.Path}} {{.Dir}}{{else}}{{.Module.Path}} {{.Module.Dir}}{{end}} {{.Dir}}{{end}}' \
      . | LC_ALL=C sort -u > /tmp/packages; \
    test -s /tmp/packages; \
    while read -r mod moddir dir; do \
      case "$dir" in "$moddir"/*) ;; *) continue ;; esac; \
      sub="${dir#"$moddir"}"; \
      while [ -n "$sub" ]; do echo "$mod $moddir $sub"; sub="${sub%/*}"; done; \
    done < /tmp/packages | LC_ALL=C sort -u > /tmp/license-dirs; \
    while read -r mod moddir sub; do \
      for f in "$moddir$sub"/*; do \
        case "${f##*/}" in \
          *.go) ;; \
          [Ll][Ii][Cc][Ee][Nn][CcSs][Ee]* | [Cc][Oo][Pp][Yy][Ii][Nn][Gg]* | \
          [Nn][Oo][Tt][Ii][Cc][Ee]* | [Pp][Aa][Tt][Ee][Nn][Tt][Ss]*) \
            if [ -f "$f" ]; then mkdir -p "$meta/licenses/${mod}${sub}"; cp "$f" "$meta/licenses/${mod}${sub}/"; fi ;; \
        esac; \
      done; \
    done < /tmp/license-dirs; \
    sh /tmp/go-licenses.sh /out/usr/local/bin/azcopy "$meta/licenses"; \
    find "$meta/licenses" -type f -name '*.go' -delete; \
    if find "$meta/licenses" -type f -size 0 | grep .; then echo "empty license file" >&2; exit 1; fi; \
    if awk '$1 == "github.com/stretchr/testify" && $3 ~ /\/internal\/spew$/ { found = 1 } END { exit !found }' /tmp/packages; then \
      test -s "$meta/licenses/github.com/stretchr/testify/internal/spew/LICENSE" \
        || { echo "testify's internal/spew is linked, but its license was not copied" >&2; exit 1; }; \
    fi; \
    psl=$(awk '$1 == "golang.org/x/net" && $3 ~ /\/publicsuffix$/ { print $3; exit }' /tmp/packages); \
    test -n "$psl" \
      || { echo "azcopy no longer links golang.org/x/net/publicsuffix: drop MPL-2.0 and its files" >&2; exit 1; }; \
    rev=$(sed -n 's/^const version = ".*, git revision \([0-9a-f]\{40\}\) (.*)"$/\1/p' "$psl/table.go"); \
    if [ "$rev" != "${PUBLIC_SUFFIX_LIST_VERSION}" ]; then \
      sed -n '/^const version = /p' "$psl/table.go" >&2; \
      echo "golang.org/x/net/publicsuffix names list commit '$rev', not ${PUBLIC_SUFFIX_LIST_VERSION}: update public-suffix-list in package.yml" >&2; \
      exit 1; \
    fi; \
    mkdir -p "$meta/mpl-sources"; \
    cp /tmp/public_suffix_list.dat "$meta/mpl-sources/public_suffix_list.dat"; \
    chmod 0644 "$meta/mpl-sources/public_suffix_list.dat"; \
    echo "${VERSION}" > "$meta/version"; \
    { \
      echo "https://github.com/Azure/azure-storage-azcopy.git@${SOURCE_COMMIT}"; \
      echo "https://github.com/Azure/azure-storage-azcopy/tree/${SOURCE_COMMIT}"; \
      echo "https://raw.githubusercontent.com/publicsuffix/list/${PUBLIC_SUFFIX_LIST_VERSION}/public_suffix_list.dat"; \
    } > "$meta/source"; \
    { \
      echo "base: ${BASE_IMAGE}"; \
      echo "go: $(go env GOVERSION)"; \
      echo "commit: ${SOURCE_COMMIT}"; \
      echo "public-suffix-list: ${PUBLIC_SUFFIX_LIST_VERSION} sha256:${PUBLIC_SUFFIX_LIST_SHA256}"; \
      cat /tmp/azcopy-version; \
      sed 1d /tmp/azcopy-modules; \
    } > "$meta/buildinfo"; \
    LC_ALL=C sort -u /tmp/runtime-deps.extra > "$meta/runtime-deps"

FROM ${BASE_IMAGE} AS slim
RUN --mount=type=bind,from=build,source=/out/usr/local/share/randomcontainers/azcopy/runtime-deps,target=/tmp/runtime-deps \
    set -eu; \
    xargs apk add --no-cache ca-certificates tini < /tmp/runtime-deps; \
    addgroup -g 1000 app; \
    adduser -D -u 1000 -G app app; \
    install -d -m 1777 /work /cache
COPY --link --from=build /out/usr/local/ /usr/local/
# azcopy keeps its logs and job plans in $HOME/.azcopy, so HOME is /cache,
# which any UID can write to. azcopy reads the all-zero instrumentation key as
# "telemetry off" (azcopy/telemetry.go); an empty value turns it back on.
ENV LANG=C.UTF-8 XDG_CACHE_HOME=/cache \
    HOME=/cache \
    AZCOPY_DISABLE_SYSLOG=true \
    AZCOPY_TELEMETRY_CONNECTION_STRING="InstrumentationKey=00000000-0000-0000-0000-000000000000"
WORKDIR /work
USER 1000:1000
ENTRYPOINT ["tini", "--", "azcopy"]
CMD ["--help"]
